---
interface Props {
  class?: string;
  showText?: boolean;
}
const { class: className = '', showText = true } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width="34"
    height="34"
    viewBox="0 0 40 40"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect x="0.75" y="0.75" width="38.5" height="38.5" rx="10.5" fill="url(#mg)" />
    <rect x="0.75" y="0.75" width="38.5" height="38.5" rx="10.5" stroke="url(#ms)" stroke-width="1.5" />
    <path
      d="M9 28.5V11.5h3.6l7.4 10.2 7.4-10.2H31v17h-3.7V18.1l-6.2 8.5h-2.2l-6.2-8.5v10.4H9Z"
      fill="#04070d"
    />
    <circle cx="20" cy="33.2" r="1.6" fill="#04070d" />
    <defs>
      <linearGradient id="mg" x1="4" y1="2" x2="36" y2="38" gradientUnits="userSpaceOnUse">
        <stop stop-color="#7ff0ff" />
        <stop offset="0.55" stop-color="#29dcff" />
        <stop offset="1" stop-color="#0396b6" />
      </linearGradient>
      <linearGradient id="ms" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
        <stop stop-color="#ffffff" stop-opacity="0.5" />
        <stop offset="1" stop-color="#ffffff" stop-opacity="0.05" />
      </linearGradient>
    </defs>
  </svg>
  {
    showText && (
      <span class="flex flex-col leading-none">
        <span class="text-[1.05rem] font-bold tracking-tight text-mist-100">MATRO</span>
        <span class="mt-0.5 font-mono text-[0.55rem] tracking-[0.18em] text-mist-500 uppercase">
          BTÜ · Est. 2013
        </span>
      </span>
    )
  }
</span>
