---
import { url } from '../lib/utils';

interface Props {
  class?: string;
  showText?: boolean;
  /** Rozet boyutu (px) */
  size?: number;
}
const { class: className = '', showText = true, size = 40 } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <img
    src={url('/logo-matro-beyaz.png')}
    alt="MATRO — Makine Teknolojileri Robot ve Otomasyon Topluluğu logosu"
    width={size}
    height={size}
    style={`width:${size}px;height:${size}px`}
    class="shrink-0 object-contain"
    loading="eager"
    decoding="async"
  />
  {
    showText && (
      <span class="flex flex-col leading-none">
        <span class="text-[1.05rem] font-bold tracking-tight text-mist-100">MATRO</span>
        <span class="mt-1 font-mono text-[0.55rem] tracking-[0.18em] text-mist-500 uppercase">
          BTÜ · Est. 2013
        </span>
      </span>
    )
  }
</span>
